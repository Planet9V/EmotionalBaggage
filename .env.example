# Copy to .env (same folder as docker-compose.yml), fill in what you have, then: docker compose up -d --build --wait
# .env is optional: without it the stack starts with the defaults below (CI starts it that way).
# Leave a line out rather than setting it to an empty value when you want the default.
# PGPASSWORD is read when the database is first created; changing it later does not change the
# password inside an existing database volume.
PGPASSWORD=c2r

# Port the app is published on (default 3000) and the database image (default pgvector/pgvector:0.8.7-pg19-trixie)
# WEB_PORT=3000
# PG_IMAGE=pgvector/pgvector:0.8.7-pg18-trixie

# AI reviewer (Concept → Challenge)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Research (Research → Ask)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
# Only to point research at another address; must not be set to an empty value
# PERPLEXITY_URL=https://api.perplexity.ai/v1/sonar

# 3D printer status (Prototype → 3D printing). octoprint or moonraker.
PRINTER_KIND=
PRINTER_URL=
PRINTER_API_KEY=

# Not built yet; listed so the Integrations page can show what is missing
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
X_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
