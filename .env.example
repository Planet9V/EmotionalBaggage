# Copy to .env (same folder as docker-compose.yml), fill in what you have, then: docker compose up -d --build --wait
# .env is optional: without it the stack starts with the defaults below (CI starts it that way).
# Leave a line out rather than setting it to an empty value when you want the default.
# PGPASSWORD is read when the database is first created; changing it later does not change the
# password inside an existing database volume.
PGPASSWORD=c2r

# Port the app is published on (default 3000) and the database image (default pgvector/pgvector:0.8.7-pg19-trixie)
# WEB_PORT=3000
# PG_IMAGE=pgvector/pgvector:0.8.7-pg19-trixie

# Database memory, for vector search. The defaults suit a machine that gives Docker 4 GB or more.
# With more memory, raise shared_buffers to about a quarter of it and effective_cache_size to about
# three quarters. Reasons and measurements: docs/design/vector-search.md
# PG_SHARED_BUFFERS=1GB
# PG_EFFECTIVE_CACHE_SIZE=3GB
# PG_MAINTENANCE_WORK_MEM=1GB
# PG_MAX_PARALLEL_MAINTENANCE_WORKERS=4
# PG_WORK_MEM=32MB
# PG_SHM_SIZE=1gb

# Models (the reviewer, search by meaning) are chosen in Admin, not here.
# A key saved in Admin takes precedence over this one.
# OPENROUTER_API_KEY=

# Research (Research → Ask)
# A key saved in the app (Admin, Credentials) takes precedence over this one.
PERPLEXITY_API_KEY=
# Only to point research at another address; the app adds /v1/agent. Must not be set to an empty value.
# PERPLEXITY_BASE_URL=https://api.perplexity.ai

# 3D printer status (Prototype → 3D printing). octoprint or moonraker.
PRINTER_KIND=
PRINTER_URL=
PRINTER_API_KEY=

# Not built yet; listed so the Integrations page can show what is missing
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
X_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
